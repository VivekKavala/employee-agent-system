# LLM Provider Configuration
# Supported values: openai_compatible, groq, gemini_openai, openai, ollama, deterministic
LLM_PROVIDER=groq

# Model Name (examples: llama-3.3-70b-versatile for Groq, gemini-2.0-flash for Gemini, gpt-4o-mini for OpenAI)
LLM_MODEL=llama-3.3-70b-versatile

# Hosted LLM API Key (never commit real keys; leave blank only when using LLM_PROVIDER=deterministic or ollama)
LLM_API_KEY=your-api-key-here

# Optional OpenAI-Compatible Base URL
# Groq: https://api.groq.com/openai/v1
# Gemini OpenAI endpoint: https://generativelanguage.googleapis.com/v1beta/openai
# Ollama local: http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Model Sampling Temperature
LLM_TEMPERATURE=0.0

# SQLite Database Path (relative to project root or absolute path)
DATABASE_PATH=data/employee_system.db

# Shared Structured Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
